# links — environment contract (AGENTS.md §5: this file is the contract).
#
# THIS FILE is the LOCAL DEVELOPMENT template: `cp .env.example .env.local`.
# For deployed instances start from the matching file instead:
#   .env.dev.example   -> ~/dev/links/.env.local   (dev-links,  port 3102)
#   .env.prod.example  -> ~/prod/links/.env.local  (prod-links, port 7102)
# Full reference (every variable, build vs runtime, dev/prod values):
# docs/ENVIRONMENTS.md. `node scripts/check-env.mjs <prod|dev>` validates a
# deployed env file; scripts/__tests__/env-docs.test.ts fails CI if a variable
# the app reads is missing from here or from the docs.
#
# NEVER commit a real .env.local. Placeholders below are shape-only.

# --- Runtime ---
# Listen port. Only used by `pnpm dev`; deployed instances get PORT from the
# pm2 entry in ecosystem.config.cjs (prod 7102, dev 3102).
PORT=3102
# Injected by next/pm2 (`production` for deployed builds). Leave it out of
# deployed env files.
NODE_ENV=development
# Public URL of this app. The HOST is the `aud` used to verify scoped app
# tokens, so it must match this app's registered tokenAudiences.
NEXT_PUBLIC_APP_URL=http://localhost:3102
# Reverse-proxy path prefix (Caddy: jin.imajin.ai/links). Must be /links.
# BUILD-TIME: baked into the bundle by next.config.js — rebuild after changing.
NEXT_PUBLIC_BASE_PATH=/links

# --- This app's own database (its own Postgres schema only) ---
# Never a kernel database or another app's schema — docs/MIGRATIONS.md.
DATABASE_URL=postgres://links:CHANGE_ME@localhost:5432/imajin_dev
# The one schema this app owns. Fixed to `links`; never change it.
APP_DB_SCHEMA=links

# --- Imajin kernel (the public app surface; AGENTS.md §2) ---
# prod: https://jin.imajin.ai   dev: https://dev-jin.imajin.ai
# Auth service base URL; MUST include the /auth prefix (read by @ima-jin/auth).
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth
# Kernel base URL (no path): signing-key fetch at boot + profile lookup.
IMAJIN_KERNEL_URL=https://dev-jin.imajin.ai
# Absolute kernel URL baked into the /dashboard redirect (next.config.js, via
# @ima-jin/config). BUILD-TIME. Without it the redirect points at the
# non-existent kernel.imajin.ai.
NEXT_PUBLIC_KERNEL_URL=https://dev-jin.imajin.ai
# Selects the kernel session cookie: `dev` -> imajin_session_dev. Set to `dev`
# on dev and local; leave UNSET on prod.
IMAJIN_ENV=dev

# --- This app's signing identity (docs/REGISTRATION.md) ---
# The signing key is never in an env file: it is fetched at boot via
# @ima-jin/auth-client's loadAppSigningKey() (instrumentation.ts).
# This app's did:imajin:… from registration. The app refuses to boot without it.
IMAJIN_APP_DID=did:imajin:REPLACE_ME
# Optional, advanced/CI path only: a one-time code from the kernel operator's
# /jin approval card, set here so first boot resolves it automatically. The
# normal operator path (imajin-ai#2427) needs NO env var — leave this unset,
# boot the app (it comes up "unclaimed": every route except /claim,
# /api/claim, /api/health serves a minimal notice page), and paste the code at
# <this app>/claim (i.e. /links/claim) in the browser instead. Delete this
# from .env.local once used — it's spent either way; a lost keystore needs a
# fresh code (`reissueClaim: true` rebind).
IMAJIN_APP_CLAIM_CODE=
# Where the 0600 bootstrap keystore lives (default ./.imajin/keystore.json).
# On a server set an absolute path that survives deploys, one per environment.
# IMAJIN_APP_KEYSTORE=
# REMOVED — the app throws at boot if this is set. Do not set it.
# IMAJIN_APP_PRIVATE_KEY=

# --- Logging (@ima-jin/logger) — stdout only; pm2 captures it ---
# pino level (default info).
# LOG_LEVEL=debug
# Leave these unset: this app never persists logs (AGENTS.md).
# ENABLE_REQUEST_LOG=
# ENABLE_APP_LOG=
# LOG_DB_TRANSPORT=
# APP_LOG_LEVEL=

# --- URL derivation fallbacks (@ima-jin/config) — prefer NEXT_PUBLIC_KERNEL_URL ---
# NEXT_PUBLIC_SERVICE_PREFIX=
# NEXT_PUBLIC_DOMAIN=

# --- @ima-jin/auth paths links does not exercise — leave unset ---
# ATTESTATION_INTERNAL_API_KEY=
# AUTH_INTERNAL_API_KEY=
# PROFILE_SERVICE_URL=
# PROFILE_INTERNAL_API_KEY=
# NODE_DID=
# APP_URL=
# NEXT_PUBLIC_BASE_URL=

# --- In the app template but read by no code in this repo (safe to omit) ---
# NEXT_PUBLIC_IMAJIN_AUTH_URL=https://dev-jin.imajin.ai
# NEXT_PUBLIC_IMAJIN_APP_ID=
# SESSION_COOKIE_SCOPE=host

# --- Set by the platform, never by hand ---
# NEXT_RUNTIME  injected by Next.js (instrumentation.ts checks it)
# --- CI only ---
# VERIFY_BOOT_PORT=4102   scripts/verify-migration-boot.mjs
