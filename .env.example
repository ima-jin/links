# --- Runtime ---
PORT=3102
NODE_ENV=development
# Public URL of this app (used to build redirects behind a reverse proxy).
NEXT_PUBLIC_APP_URL=http://localhost:3102
# This app is Caddy-routed under the kernel host behind the /links path
# prefix (same convention as ima-jin/dykil's /dykil) — never a bare root
# mount. Read by next.config.js at build/boot time AND by
# src/lib/base-path.ts's withBasePath() helper for raw fetch()/<a href>/
# redirect() calls Next.js doesn't auto-prefix.
NEXT_PUBLIC_BASE_PATH=/links

# --- This app's own database (its own Postgres schema only) ---
# drizzle-orm + postgres (postgres.js). Never a kernel database or another
# app's schema — see docs/MIGRATIONS.md.
DATABASE_URL=postgres://user:password@localhost:5432/imajin_dev
# The Postgres schema this app owns exclusively. Set once, at registration
# time, and never changed afterwards — see docs/MIGRATIONS.md.
APP_DB_SCHEMA=links

# --- Imajin kernel (the public app surface this app composes; see AGENTS.md §2) ---
# prod: https://jin.imajin.ai   dev: https://dev-jin.imajin.ai
# AUTH_SERVICE_URL is read directly by the published @ima-jin/auth package
# (requireSessionOrAppToken, verifyAppToken, getSession, ...) and MUST
# already include the /auth prefix, e.g. https://dev-jin.imajin.ai/auth.
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth
# Public equivalent, exposed to the browser for the "Sign in with Imajin"
# link and the client-side session check (Next.js only bundles
# NEXT_PUBLIC_* vars client-side).
NEXT_PUBLIC_IMAJIN_AUTH_URL=https://dev-jin.imajin.ai

# --- This app's signing identity (see docs/REGISTRATION.md) ---
# This app never holds its own private key in an env file. Instead it
# fetches its vault-minted signing key at boot via @ima-jin/auth-client's
# loadAppSigningKey() (refs imajin-ai#2411) — see instrumentation.ts and
# src/lib/auth/signing-identity.ts.
#
# The kernel node that grants + serves this app's signing key.
IMAJIN_KERNEL_URL=https://dev-jin.imajin.ai
# This app's own did:imajin:..., derived from its public key. Required on
# every boot once a local keystore already exists; a true first boot gets
# it back directly from the claim exchange below.
IMAJIN_APP_DID=did:imajin:REPLACE_ME
# This app's public registry id (`app_...`), returned by registration.
NEXT_PUBLIC_IMAJIN_APP_ID=
# One-time code from the kernel operator's /jin approval card (apps.provision).
# Required ONLY on a true first boot (no local keystore yet) or after a
# lost-keystore `reissueClaim: true` rebind — delete it once this app has
# booted successfully once. Never reused: redeeming it binds this app's own
# freshly minted bootstrap keypair to the grant.
IMAJIN_APP_CLAIM_CODE=
# Where loadAppSigningKey() persists this app's own bootstrap keypair
# (NEVER the vault signing key itself) between restarts, mode 0600. Optional
# — defaults to ./.imajin/keystore.json. Must be writable, and must never be
# committed or synced anywhere the claim code wasn't also meant to go.
IMAJIN_APP_KEYSTORE=

# --- Session (shared kernel session cookie fallback of requireSessionOrAppToken) ---
# This app is mounted same-origin behind the kernel's own Caddy host (a
# /links path prefix, not a separate subdomain), so the browser's existing
# kernel session cookie is naturally in scope — see src/lib/auth/authenticate.ts.
SESSION_COOKIE_SCOPE=host
